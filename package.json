{
  "name": "typescript-workshop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript 工坊：免费开源的中文交互式 TypeScript 学习平台",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "npm run prepare:assets && concurrently -k -n sandbox,app \"npm:watch:sandbox\" \"vite\"",
    "build": "npm run prepare:assets && tsc -b && vite build",
    "build:sandbox": "tsx scripts/build-sandbox.ts",
    "watch:sandbox": "tsx scripts/build-sandbox.ts --watch",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:build": "tsx scripts/build-content.ts",
    "content:check": "tsx scripts/check-content.ts",
    "test:e2e": "playwright test --project=e2e",
    "content:verify": "playwright test --project=content",
    "check": "npm run typecheck && npm run lint && npm run test && npm run content:check",
    "build:types": "tsx scripts/build-types.ts",
    "prepare:assets": "npm run build:types && npm run content:build && npm run build:sandbox"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@typescript/vfs": "1.6.5",
    "codemirror": "6.0.2",
    "dom-accessibility-api": "0.5.16",
    "expect-type": "1.4.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.0",
    "unified": "11.0.5",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
