{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "@testing-library/jest-dom/vitest"]
  },
  "include": [
    "tests",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test",
    "src/compiler/core/node-loader.ts",
    "sandbox/src/**/*.test.ts",
    "server/**/*.test.ts",
    "scripts/**/*.test.ts"
  ]
}
